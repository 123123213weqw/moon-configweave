{
  "layers": [
    {
      "name": "base",
      "file": "base.json"
    },
    {
      "name": "macos",
      "file": "macos.json"
    }
  ],
  "arrays": "unique",
  "constraints": [
    {
      "path": "/job/runner",
      "type": "string",
      "enum": [
        "ubuntu-latest",
        "macos-14",
        "windows-2022"
      ]
    },
    {
      "path": "/job/timeout_minutes",
      "type": "number",
      "min": 5,
      "max": 120
    },
    {
      "path": "/matrix/targets",
      "type": "array"
    }
  ]
}
